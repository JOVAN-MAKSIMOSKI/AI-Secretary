
# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LangChain Configuration (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# ---------------------------------------------------------------------------
# RAG / Qdrant — waste-law advisor
# ---------------------------------------------------------------------------
# Target collection; scripts/ingest.py and services/ragagent.py both read this
QDRANT_COLLECTION=waste_management_law_mk_v2
# Local Qdrant storage dir (default: apps/agent/src/rag-agent/qdrant_data)
QDRANT_LOCAL_PATH=
# Remote Qdrant instead of local (optional)
QDRANT_URL=
QDRANT_API_KEY=

# Answer-synthesis LLM: auto|openai|anthropic
# openai + gpt-4o-mini for development; switch model to gpt-4o only for final QA
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini
# OpenAI key — RAG answers, extraction chains, scripts/ingest.py metadata pass,
# scripts/enrich_metadata.py. Required: "github" was removed when GitHub Models retired.
OPENAI_API_KEY=

# Embeddings: huggingface = local multilingual-e5-large (must match ingest model)
RAG_EMBED_PROVIDER=huggingface
RAG_EMBED_MODEL=intfloat/multilingual-e5-large

# OCR for scanned law PDFs (scripts/ingest.py) — path to tesseract.exe if not on PATH
TESSERACT_CMD=

# Shared secret for agent→python internal calls (STT/TTS). Must match apps/agent/.env
INTER_SERVICE_SECRET=

# Azure Cognitive Services TTS (Macedonian neural voice)
# Create a Speech resource in Azure portal → Keys and Endpoint
AZURE_TTS_KEY=                          # from Azure portal → Keys and Endpoint
AZURE_TTS_REGION=germanywestcentral     # must match your Azure Speech resource region
AZURE_TTS_VOICE=mk-MK-MarijaNeural     # Macedonian female neural voice (default)

# Bitola-dialect voice tuning (tts/ssml.py). OFF by default — the stock Azure voice is
# used with no prosody changes and no word substitutions. Set to true only if you want
# the tuned character voice back; it shifts pitch/rate/volume and rewrites whole words
# (e.g. "здраво" is spoken as "кај си море муце"), so it is not a neutral setting.
AZURE_TTS_DIALECT_TUNING=

# RVC voice conversion (optional — leave RVC_MODEL_PATH unset to use Azure TTS output directly)
RVC_MODEL_PATH=                         # full path to your trained .pth file
RVC_INDEX_PATH=                         # full path to the .index faiss file (optional)
RVC_DEVICE=cpu                          # cpu or cuda
RVC_INDEX_RATE=0.75
RVC_F0_METHOD=rmvpe
RVC_F0_UP_KEY=0                         # semitone shift; 0 = no pitch change
