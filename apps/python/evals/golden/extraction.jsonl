// Golden extraction set — layer 1 of the invoice pipeline, plus calendar and offer chains.
// One JSON object per line; // comments allowed. Authored against measured chain output
// (probe run 2026-07-23), not guessed.
//
// Expected-value markers:
//   "@tomorrow"      — resolves to (today + 1 day) ISO date at runtime, for relative-date cases
//   "@absent"        — the key must be missing (or null): the chain must not invent a value
//   "contains:x"     — case-insensitive substring match; everything else is exact (numbers with tolerance)

{"id": "ext-inv-mk-full", "chain": "invoice", "message": "Направи фактура за Тангента за 10 единици по 1500 денари, ДДВ 18%", "expect": {"invoice_type": "goods", "firm_name": "contains:тангента", "units": 10, "price_per_unit": 1500, "tax_percentage": 18, "price_before_tax": 15000, "price_after_tax": 12300}}
{"id": "ext-inv-en-full", "chain": "invoice", "message": "Create an invoice for client Petrov, 5 units at 2000 denars each, 18% tax", "expect": {"firm_name": "contains:petrov", "units": 5, "price_per_unit": 2000, "tax_percentage": 18, "price_before_tax": 10000, "price_after_tax": 8200}}
{"id": "ext-inv-mk-voice-words", "chain": "invoice", "message": "фактура за извршен транспорт пет парчиња по илјада денари", "expect": {"invoice_type": "transport", "units": 5, "price_per_unit": 1000, "tax_percentage": 5, "price_after_tax": 4750}, "note": "Voice surface: Whisper transcribes spoken amounts as number words; transport type must default to 5% tax."}
{"id": "ext-inv-mk-no-amounts", "chain": "invoice", "message": "Направи фактура за Тангента за консултантски услуги", "expect": {"units": "@absent", "price_per_unit": "@absent", "price_after_tax": "@absent"}, "note": "Omission guard: no amounts in the message means no invented numbers on the invoice."}

{"id": "ext-cal-mk-tomorrow", "chain": "calendar", "message": "Закажи состанок со Марко утре во 14:00 за 45 минути", "expect": {"event_date": "@tomorrow", "event_time": "14:00", "duration_minutes": 45, "event_name": "contains:марко"}}
{"id": "ext-cal-en-absolute", "chain": "calendar", "message": "Schedule a meeting with the accountant on 2026-08-03 at 09:30 for 30 minutes", "expect": {"event_date": "2026-08-03", "event_time": "09:30", "duration_minutes": 30, "event_name": "contains:accountant"}, "note": "Regression guard: this case first caught event_name coming back in Russian ('встреча с бухгалтером') because only the Cyrillic branch of the calendar prompt's language_hint had an explicit language instruction. Fixed 2026-07-23 by adding an equivalent English-branch instruction in langchain.py."}
{"id": "ext-cal-mk-absolute", "chain": "calendar", "message": "Закажи повик со сметководителот на 2026-08-10 во 11:00", "expect": {"event_date": "2026-08-10", "event_time": "11:00"}}

{"id": "ext-off-mk", "chain": "offer", "message": "Подготви понуда за годишно одржување во вредност од 24000 денари, важи до 15.08.2026", "expect": {"amount": 24000, "due_date": "2026-08-15", "title": "contains:одржување"}, "note": "European date format 15.08.2026 must normalise to ISO."}
{"id": "ext-off-en", "chain": "offer", "message": "Prepare an offer for container rental worth 5000 denars, valid until 2026-09-01", "expect": {"amount": 5000, "due_date": "2026-09-01"}}

// ── Waste forms ──────────────────────────────────────────────────────────────────
// Authored against measured chain output (probe run 2026-07-28, two identical runs).
// `expect` encodes CORRECT behaviour, not current behaviour: three reproducible defects
// are deliberately left failing so they stay printed in the report. See
// extraction_baseline.json for which floor absorbs which.
//
// Both chains share one closed list of 30 waste descriptions and derive ewc_code +
// is_hazardous in Python from whichever description the model copies, so a waste_type
// miss silently costs the code fields too — which is why those are asserted alongside it.

{"id": "ext-tf-mk-full", "chain": "transport_form", "message": "Направи транспортен формулар за Тангента 2.0, отпадни масла, вкупно 500 кг, собрани 480 кг на 2026-08-05, примени 470 кг на депонија Дрисла на 2026-08-07", "expect": {"firm_name": "contains:тангента", "disposal_place_name": "contains:дрисла", "waste_type": "Отпадни масла (моторни, хидраулични, подмачкувачи)", "ewc_code": "13 02 05*", "is_hazardous": true, "waste_owner_total_kg": 500, "collector_total_kg": 480, "collector_date": "2026-08-05", "end_owner_total_kg": 470, "end_owner_date": "2026-08-07"}, "note": "Slot-mapping guard: the three weights are deliberately all different (500/480/470) so a chain that collapses them onto one box fails here. This is the transport form's most consequential extraction risk — the schema carries three weights but only two dates, because sections 4 and 5 are two sides of one handover."}
{"id": "ext-tf-en-full", "chain": "transport_form", "message": "Create a transport form for ACME Ltd: 300 kg of used vehicle tyres declared, 295 kg collected on 2026-09-10, and 295 kg received at the Drisla landfill on 2026-09-12", "expect": {"firm_name": "contains:acme", "disposal_place_name": "contains:drisla", "waste_type": "Искористени гуми од возила", "ewc_code": "16 01 03", "is_hazardous": false, "waste_owner_total_kg": 300, "collector_total_kg": 295, "collector_date": "2026-09-10", "end_owner_total_kg": 295, "end_owner_date": "2026-09-12"}, "note": "DEFECT (reproducible 2026-07-28): disposal_place_name comes back absent. The chain finds it when phrased 'на/до депонија X' but not from 'at the X landfill'. The English waste_type snap onto the Macedonian closed list works here, so this is a party-extraction gap, not a translation one."}
{"id": "ext-tf-mk-voice-words", "chain": "transport_form", "message": "транспортен формулар за Технокоп, оловни акумулатори и батерии, илјада килограми предадени, илјада примени на 2026-08-05, илјада на депонија Дрисла на 2026-08-06", "expect": {"firm_name": "contains:технокоп", "waste_type": "Оловни акумулатори и батерии", "ewc_code": "16 06 01*", "is_hazardous": true, "waste_owner_total_kg": 1000, "collector_total_kg": 1000, "end_owner_total_kg": 1000, "collector_date": "2026-08-05", "end_owner_date": "2026-08-06"}, "note": "Voice surface: Whisper transcribes spoken weights as words — 'илјада' must become 1000."}
{"id": "ext-tf-mk-unmapped-waste", "chain": "transport_form", "message": "Направи транспортен формулар за Тангента, отпад од стакло, 200 кг, собрани 200 кг на 2026-08-05, примени 200 кг во Дрисла на 2026-08-06", "expect": {"ewc_code": "@absent", "is_hazardous": "@absent", "waste_owner_total_kg": 200, "collector_total_kg": 200}, "note": "Fabrication guard: glass waste is on neither code map, so both derived fields must stay absent and fail loudly downstream rather than ship a wrong EWC code on a legal document. This chain passes it; the identification chain does not — see ext-idf-mk-unmapped-waste."}
{"id": "ext-tf-mk-party-direction", "chain": "transport_form", "message": "Отпадот од мешано пакување го носиме до депонија Русино, а сопственик на отпадот е фирмата Бетон АД. 120 кг, собрани 120 кг на 2026-08-11, примени 120 кг на 2026-08-12", "expect": {"firm_name": "contains:бетон", "disposal_place_name": "contains:русино", "waste_type": "Мешано пакување", "ewc_code": "15 01 06", "is_hazardous": false}, "note": "Role-vs-position guard: the destination is named FIRST and the owner second, so a chain assigning parties by order of appearance swaps them. Swapped parties render a form that is valid-looking and legally wrong."}
{"id": "ext-tf-mk-partial", "chain": "transport_form", "message": "Направи транспортен формулар за Тангента, мешан комунален отпад", "expect": {"firm_name": "contains:тангента", "waste_type": "Мешан комунален отпад", "ewc_code": "20 03 01", "disposal_place_name": "@absent", "waste_owner_total_kg": "@absent", "collector_total_kg": "@absent", "collector_date": "@absent", "end_owner_total_kg": "@absent", "end_owner_date": "@absent"}, "note": "Omission guard: no weights, dates, or destination stated means none invented."}
{"id": "ext-idf-mk-full", "chain": "identification_form", "message": "Направи идентификационен формулар за Тангента 2.0, одговорен Јован Максимоски, отпадот е во магацинот во Скопје, инфективен медицински отпад, спакуван во буриња, 250 кг, потекнува од производство, операција D10, потпишано во Скопје на 2026-08-15", "expect": {"firm_name": "contains:тангента", "contact_name": "contains:максимоски", "waste_type": "Инфективен медицински отпад (од хумана или ветеринарна медицина)", "ewc_code": "18 01 03*", "is_hazardous": true, "packing_method": "Буриња", "total_weight_kg": 250, "waste_origin": "Производство", "waste_operation_code": "D10", "place": "contains:скопје", "date": "2026-08-15"}, "note": "Exercises all four closed lists at once — waste_type, packing_method, waste_origin, waste_operation_code."}
{"id": "ext-idf-en-full", "chain": "identification_form", "message": "Create an identification form for ACME Ltd, responsible person Marko Petrov, waste stored at the Skopje warehouse, paper and cardboard packaging, packed in cardboard boxes, 180 kg, originating from the warehouse, operation R13, signed in Skopje on 2026-08-20", "expect": {"firm_name": "contains:acme", "contact_name": "contains:petrov", "waste_type": "Пакување од хартија и картон", "ewc_code": "15 01 01", "is_hazardous": false, "packing_method": "Картонски кутии", "total_weight_kg": 180, "waste_origin": "Магацин", "waste_operation_code": "R13", "date": "2026-08-20"}, "note": "DEFECT (reproducible 2026-07-28): waste_type comes back absent from an English message, taking ewc_code and is_hazardous with it — three misses from one cause. The other three closed lists snap from English fine in this same call, so the failure is specific to the 30-option waste list, not to English input."}
{"id": "ext-idf-mk-voice-words", "chain": "identification_form", "message": "идентификационен формулар за Технокоп, искористени гуми од возила, рефус, сто килограми, од магацин, R1", "expect": {"firm_name": "contains:технокоп", "waste_type": "Искористени гуми од возила", "ewc_code": "16 01 03", "is_hazardous": false, "packing_method": "Рефус", "total_weight_kg": 100, "waste_origin": "Магацин", "waste_operation_code": "R1"}, "note": "Voice surface: 'сто' must become 100."}
{"id": "ext-idf-mk-unmapped-waste", "chain": "identification_form", "message": "Направи идентификационен формулар за Тангента, отпад од стакло, 200 кг, во џамбо вреќи, од администрација", "expect": {"ewc_code": "@absent", "is_hazardous": "@absent", "packing_method": "Џамбо вреќи", "total_weight_kg": 200, "waste_origin": "Администрација"}, "note": "DEFECT (reproducible 2026-07-28), and the most serious one in this file: glass waste is snapped onto 'Отпад од пластика' (plastic), fabricating code 02 01 04 on a legal document. The Python-side guard in _resolve_ewc_code_from_waste_type only fires when the model OMITS an unmatched waste_type; here it paraphrases glass into a real list entry, so the lookup succeeds on a wrong-but-valid description and the guard never sees it. The transport chain gets this same input right."}
{"id": "ext-idf-mk-nonhazardous-twin", "chain": "identification_form", "message": "идентификационен формулар за Тангента, апсорбенти и крпи за бришење кои не се контаминирани со опасни супстанции, 60 кг, во картонски кутии, од производство, R13", "expect": {"waste_type": "Апсорбенти, филтерски материјали, крпи за бришење и заштитна облека поинакви од наведените во 15 02 02*", "ewc_code": "15 02 03", "is_hazardous": false, "packing_method": "Картонски кутии", "total_weight_kg": 60, "waste_origin": "Производство", "waste_operation_code": "R13"}, "note": "Hazard-boundary guard: the closed list contains a near-identical twin pair — 15 02 02* (contaminated, hazardous) and 15 02 03 (not contaminated). Picking the wrong one flips is_hazardous, which then selects the wrong permit number on the transport form. The message says explicitly NOT contaminated."}
{"id": "ext-idf-mk-partial", "chain": "identification_form", "message": "Направи идентификационен формулар за Тангента", "expect": {"firm_name": "contains:тангента", "contact_name": "@absent", "waste_type": "@absent", "ewc_code": "@absent", "total_weight_kg": "@absent", "packing_method": "@absent", "waste_origin": "@absent", "waste_operation_code": "@absent", "date": "@absent"}, "note": "Omission guard: a bare request must not invent a waste type, weight, or any closed-list pick."}
