# Supabase Postgres via connection pooling (Prisma runtime)
DATABASE_URL=
# Direct connection — used for migrations
DIRECT_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (Gmail app password) for outbound mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth (Gmail + Calendar MCP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# Intent router (waste-law RAG Phase 4a — LLM-only routing)
# ---------------------------------------------------------------------------
# openai | github | anthropic | auto. Never "keyword" — the LLM must always route first.
# auto priority: OPENAI_API_KEY, then GITHUB_MODELS_TOKEN (free tier, daily request
# caps), then ANTHROPIC_API_KEY. Each is skipped when its credential is absent.
ROUTER_LLM_PROVIDER=github
# Keep false: a resolver failure must surface as an error, not a keyword guess.
ROUTER_ALLOW_KEYWORD_FALLBACK=false
# Optional model overrides (openai defaults to gpt-4o-mini, github to gpt-4o)
ROUTER_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Evaluation-only OpenAI key, read by src/evals/. Mapped onto OPENAI_API_KEY inside the
# eval process only — it never becomes the running service's credential. Keep it separate
# from OPENAI_API_KEY above so eval spend stays attributable and revocable on its own.
EVALAPIKEY=

# General chat chain (agent/generalChatChain.ts) — the `general_chat` catch-all on both
# the dashboard and the phone. Its own OpenAI key on purpose: naming it OPENAI_API_KEY
# would also flip the resolver's auto-mode onto paid routing, since OpenAI outranks the
# free GitHub Models tier there. Without this var the chain throws and the caller gets a
# graceful error; every other chain keeps working.
GENERAL_CHAT_API_KEY=
# Optional override. Default gpt-5-nano: cheapest model that supports the hosted
# web_search tool (gpt-4.1-nano rejects it), and being a gpt-5 reasoning model it bills
# searches at $10/1k rather than the $25/1k non-reasoning tier. Any replacement must
# support web_search on the Responses API.
GENERAL_CHAT_MODEL=

# RAG answer-synthesis LLM settings forwarded to the resolver
RAG_LLM_PROVIDER=github
RAG_LLM_MODEL=gpt-4o
GITHUB_MODELS_TOKEN=

# Shared secret for agent→python internal calls (STT/TTS). Must match apps/python/.env
INTER_SERVICE_SECRET=

# Twilio voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PRIVATE_KEY_PEM=
TWILIO_RECORDING_KEY_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Public base URL of this service (ngrok in dev, production domain in prod)
AGENT_PUBLIC_URL=
TWILIO_DEV_TENANT_ID=

# TTS provider: azure_rvc (active) | elevenlabs (fallback)
VOICE_TTS_PROVIDER=azure_rvc

# Python service base URL (documents, RAG, STT)
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PY_SERVICE_URL=http://localhost:8000

# Daily 03:00 sweep that DELETES generated invoice/offer files (and their DB rows)
# older than 7 days from Supabase Storage. Irreversible. Leave unset/false in dev.
STORAGE_CLEANUP_ENABLED=false
