// Golden set for chain routing. One JSON object per line; // comments allowed.
// Every ChainId in chainRegistry.ts needs at least MIN_GOLDEN_CASES_PER_CHAIN entries
// or the offline eval fails the build. Add cases here when you add a chain.
// Traffic is predominantly Macedonian, so cases are deliberately bilingual.

{"id": "inv-mk-basic", "message": "Направи фактура за ACME, 10 единици по 1500 денари, ДДВ 18%", "expect": "invoice_extraction", "minConfidence": 0.6}
{"id": "inv-en-basic", "message": "Create an invoice for client Petrov, 5 units at 2000 MKD each", "expect": "invoice_extraction", "minConfidence": 0.6}
{"id": "inv-en-consulting", "message": "Bill Nikola for 3 days of consulting at 4000 denars per day", "expect": "invoice_extraction", "minConfidence": 0.6}

{"id": "off-mk-maintenance", "message": "Подготви понуда за годишно одржување за фирма Тангента", "expect": "offer_extraction", "minConfidence": 0.6}
{"id": "off-en-waste-contract", "message": "Draft a proposal for a 12-month waste collection contract", "expect": "offer_extraction", "minConfidence": 0.5, "note": "Contains 'waste' — must not pull waste_law_query. Commercial proposal, not a legal question."}
{"id": "off-mk-containers", "message": "Направи ми понуда за 20 контејнери со цена од 8000 денари", "expect": "offer_extraction", "minConfidence": 0.5, "note": "Priced line items look invoice-shaped — separates offer from invoice intent."}
{"id": "off-en-quotation", "message": "Send a quotation for the recycling equipment, valid 30 days", "expect": "offer_extraction", "minConfidence": 0.6}

{"id": "cal-mk-meeting", "message": "Закажи состанок со Марко утре во 14:00 за 45 минути", "expect": "calendar_event_extraction", "minConfidence": 0.6}
{"id": "cal-en-inspector", "message": "Schedule a call with the waste inspector next Tuesday at 9am", "expect": "calendar_event_extraction", "minConfidence": 0.5, "note": "Mentions waste inspector — scheduling intent must win over the legal topic."}
{"id": "cal-mk-delivery", "message": "Додај во календар: испорака на контејнери, петок 10:00", "expect": "calendar_event_extraction", "minConfidence": 0.6}
