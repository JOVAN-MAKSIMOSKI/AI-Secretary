generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

enum InvoiceType {
  goods
  transport

  @@schema("public")
}

model firms {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String     @db.Uuid
  name       String
  city       String?
  tax_number String?
  email      String
  phone      String?
  address    String?
  notes      String?
  // Waste-management permit number of the firm. Text (not numeric) to preserve
  // leading zeros / separators. Read onto identification forms via firm_id.
  permit_number String?
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  businesses businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)
  invoices   invoices[]
  offers     offers[]
  transport_forms transport_forms[]
  identification_forms identification_forms[]
  contacts   contacts[]

  @@index([tenant_id])
  @@schema("public")
}

model invoices {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String     @db.Uuid
  firm_id     String     @default(uuid()) @db.Uuid
  invoice_number String?
  invoice_type   InvoiceType?
  invoice_date   DateTime?  @db.Date
  value_date     DateTime?  @db.Date
  consignment_note_number Int?
  order_number   Int?
  description    String?
  units          Int?
  price_per_unit Decimal?   @db.Decimal(12, 2)
  tax_percentage Decimal?   @db.Decimal(5, 2)
  tax_total      Decimal?   @db.Decimal(12, 2)
  price_before_tax Decimal? @db.Decimal(12, 2)
  price_after_tax Decimal?  @db.Decimal(12, 2)
  price_after_tax_text String?
  title       String
  status      String     @default("draft")
  template_id String?    @db.Uuid
  amount      Decimal?   @db.Decimal(10, 2)
  due_date    DateTime?  @db.Timestamptz(6)
  sent_at     DateTime?  @db.Timestamptz(6)
  paid_at     DateTime?  @db.Timestamptz(6)
  storagePath   String    @unique
  origin        String    @default("manual")
  downloaded_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  firms       firms      @relation(fields: [firm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  templates   templatesInvoice? @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  businesses  businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([firm_id])
  @@index([tenant_id])
  @@schema("public")
}
model offers {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String     @db.Uuid
  firm_id     String     @default(uuid()) @db.Uuid
  title       String
  status      String     @default("draft")
  file_url    String?
  template_id String?    @db.Uuid
  amount      Decimal?   @db.Decimal(10, 2)
  due_date    DateTime?  @db.Timestamptz(6)
  sent_at     DateTime?  @db.Timestamptz(6)
  paid_at     DateTime?  @db.Timestamptz(6)
  storagePath String   @unique
  sizeBytes   BigInt?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  firms       firms      @relation(fields: [firm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  templates   templatesOffer? @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  businesses  businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([firm_id])
  @@index([tenant_id])
  @@schema("public")
}

model templatesOffer {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String     @db.Uuid
  name       String
  content    String
  storagePath String   @unique
  sizeBytes   BigInt?
  type       String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  offers     offers[]
  businesses businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@schema("public")
}

model templatesInvoice {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String     @db.Uuid
  name       String
  content    String
  storagePath String   @unique
  sizeBytes   BigInt?
  type       String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  invoices   invoices[]
  businesses businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@schema("public")
}

// Per-tenant stored template for the waste transport form. Same shape as
// templatesInvoice — an uploaded .xlsx with {{placeholder}} tokens. No render step
// yet, so nothing relates back to it besides the tenant.
model templatesTransportForm {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String     @db.Uuid
  name        String
  content     String
  storagePath String     @unique
  sizeBytes   BigInt?
  type        String
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@schema("public")
}

// Per-tenant stored template for the waste identification form. Same shape as
// templatesInvoice.
model templatesIdentificationForm {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String     @db.Uuid
  name        String
  content     String
  storagePath String     @unique
  sizeBytes   BigInt?
  type        String
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@schema("public")
}

model businesses {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_auth_id String     @unique @db.Uuid
  name          String
  email         String     @unique
  tax_number    String?
  transaction_account String?
  depositor     String?
  phone         String?
  address       String?
  logo_url      String?
  // Waste-management permit numbers, entered from the Settings UI. Stored as text
  // (not Int) to preserve leading zeros / separators in official permit numbers.
  dangerous_waste_permit_number String?
  permit_number                 String?
  plan          String     @default("free")
  // Waste-law advisor profile (entity type, sector, waste types, volume…) —
  // formatted into the RAG prompt as tenant context; null = not yet set up
  tenantprofilecontext Json? @db.JsonB
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  firms         firms[]
  invoices      invoices[]
  templatesInvoice  templatesInvoice[]
  templatesOffer    templatesOffer[]
  templatesTransportForm       templatesTransportForm[]
  templatesIdentificationForm  templatesIdentificationForm[]
  offers        offers[]
  gmail_oauth_connections gmail_oauth_connections[]
  tasks                   tasks[]
  audit_logs              audit_logs[]
  disposal_places         disposal_places[]
  contacts                contacts[]
  transport_forms         transport_forms[]
  identification_forms    identification_forms[]

  @@index([phone])
  @@schema("public")
}

model contacts {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String     @db.Uuid
  // A contact belongs to exactly one firm (the responsible person for that firm's
  // waste). NOT NULL: every contact is created under a firm. Cascade so deleting a
  // firm removes its contacts.
  firm_id      String     @db.Uuid
  name         String
  email        String
  // Text, not numeric: preserves leading zeros, '+' country codes, and separators.
  phone_number String
  address      String
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  businesses   businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)
  firms        firms      @relation(fields: [firm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  identification_forms identification_forms[]

  @@index([tenant_id])
  @@index([firm_id])
  @@schema("public")
}

// Waste transport manifest. Treated like invoices: it REFERENCES parties by FK id
// rather than snapshotting their details. Waste owner = firm_id, end owner =
// disposal_place_id, collector = the tenant itself (tenant_id; its permit is read
// from businesses.permit_number / dangerous_waste_permit_number at render, chosen by
// is_hazardous). Only data that lives on no other table is stored: waste
// classification, the per-party kg + dates, and note. Section 7's begin/end destination
// is derived at render from the two party NAMES (firm.name – disposal_place.name), and
// the handover town comes from firms.city — none of the three are stored here.
// waste_type/ewc_code are validated by the Pydantic TransportFormRequest gate, which
// reads the same code maps generated from src/agent/wasteChapters.ts.
model transport_forms {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String @db.Uuid
  firm_id           String @db.Uuid
  disposal_place_id String @db.Uuid

  // Waste classification (not on any table — stored here)
  waste_type   String
  is_hazardous Boolean
  ewc_code     String

  // Per-party weights and dates (form data, not derivable from any table).
  // Three weights, two dates — matching the template's boxes: waste_owner_total_kg is
  // section 3's declared quantity, collector_total_kg + collector_date are the shared
  // section 4/5 handover pair (one event, recorded by both sides), and end_owner_* is
  // section 6's receipt at the disposal place.
  waste_owner_total_kg Decimal  @db.Decimal(12, 2)
  collector_total_kg   Decimal  @db.Decimal(12, 2)
  collector_date       DateTime @db.Date
  end_owner_total_kg   Decimal  @db.Decimal(12, 2)
  end_owner_date       DateTime @db.Date

  note String?

  // Generated-document tracking, treated like invoices. storagePath is unique so a
  // regenerated form (same id) overwrites its file rather than duplicating a path.
  storagePath String? @unique
  status      String  @default("draft")
  title       String?
  template_id String? @db.Uuid

  // Call-origin tracking, same as invoices and identification_forms: a form generated
  // over a Twilio call has no browser to download it, so origin='call' +
  // downloaded_at=null surfaces it in the dashboard's pending-call-forms card until the
  // owner downloads it.
  origin        String    @default("manual")
  downloaded_at DateTime? @db.Timestamptz(6)

  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  firms           firms           @relation(fields: [firm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  disposal_places disposal_places @relation(fields: [disposal_place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  businesses      businesses      @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@index([firm_id])
  @@index([disposal_place_id])
  @@schema("public")
}

// Waste identification form. Like invoices/transport_forms: REFERENCES parties by FK
// id rather than snapshotting. Waste owner = firm_id (name/address/permit read from the
// firm at render), responsible person = contact_id (name/phone/email read from the
// contact). Only data on no other table is stored: waste_location and the wasteInfo
// fields. Reference strings (waste_type, ewc_code, packing_method, waste_origin,
// waste_operation_code) are validated against the TS unions in src/agent/wasteChapters.ts.
model identification_forms {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String @db.Uuid
  firm_id    String @db.Uuid
  contact_id String @db.Uuid

  // Waste owner detail not on any table
  waste_location String

  // Waste info (all stored — not derivable from any table)
  is_hazardous         Boolean
  waste_type           String
  ewc_code             String
  packing_method       String
  total_weight_kg      Decimal  @db.Decimal(12, 2)
  waste_origin         String
  waste_operation_code String
  place                String
  date                 DateTime @db.Date

  // Generated-document tracking, treated like invoices. storagePath is unique so a
  // regenerated form (same id) overwrites its file rather than duplicating a path.
  storagePath String? @unique
  status      String  @default("draft")
  title       String?
  template_id String? @db.Uuid

  // Call-origin tracking, same as invoices: a form generated over a Twilio call has no
  // browser to download it, so origin='call' + downloaded_at=null surfaces it in the
  // dashboard's pending-call-forms card until the owner downloads it.
  origin        String    @default("manual")
  downloaded_at DateTime? @db.Timestamptz(6)

  created_at DateTime   @default(now()) @db.Timestamptz(6)
  firms      firms      @relation(fields: [firm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contacts   contacts   @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  businesses businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@index([firm_id])
  @@index([contact_id])
  @@schema("public")
}

model disposal_places {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String     @db.Uuid
  name         String
  address      String
  place        String
  email        String
  // Text, not numeric: preserves leading zeros, '+' country codes, and separators
  // in phone numbers (same reason firms.phone is a String).
  phone_number String
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  businesses   businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)
  transport_forms transport_forms[]

  @@index([tenant_id])
  @@schema("public")
}

model gmail_oauth_connections {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  user_auth_id     String    @db.Uuid
  google_email     String?
  scopes           String[]  @default([])
  access_token_enc String?
  refresh_token_enc String
  expiry_date      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  businesses       businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, user_auth_id])
  @@index([user_auth_id])
  @@index([tenant_id])
  @@schema("public")
}

model tasks {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  title       String
  notes       String?
  due_at      DateTime? @db.Timestamptz(6)
  status      String    @default("pending")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  businesses  businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, status])
  @@index([tenant_id, due_at])
  @@schema("public")
}

model audit_logs {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String   @db.Uuid
  user_auth_id String   @db.Uuid
  action_type  String
  meta         Json     @default("{}") @db.JsonB
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  businesses   businesses @relation(fields: [tenant_id], references: [owner_auth_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@index([action_type])
  @@schema("public")
}

